{
  "dashboard": {
    "id": null,
    "title": "Lab 7 - Architecture Événementielle",
    "tags": ["lab7", "event-driven", "microservices"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Événements Traités par Seconde",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(events_processed_total[5m])",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Santé des Services",
        "type": "stat",
        "targets": [
          {
            "expr": "up",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Niveaux de Stock",
        "type": "table",
